    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="startValue" type="Integer" array="False" size=""/>
            <declare name="stopValue" type="Integer" array="False" size=""/>
            <declare name="incrementValue" type="Integer" array="False" size=""/>
            <declare name="currentValue" type="Integer" array="False" size=""/>
            <input variable="startValue"/>
            <input variable="stopValue"/>
            <input variable="incrementValue"/>
            <assign variable="currentValue" expression="startValue"/>
            <while expression="currentvalue&lt;=stopValue">
                <output expression="currentValue" newline="True"/>
                <assign variable="currentValue" expression="currentValue+incrementValue"/>
            </while>
        </body>
    </function>
